# MyCampus API — environment template
# Copy to .env and adjust for your machine.

NODE_ENV=development
PORT=4000

# MongoDB (local or Docker: docker compose up -d mongo)
MONGO_URI=mongodb://127.0.0.1:27017/mycampus

# Change this in every non-local environment.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list or * for local dev
CORS_ORIGIN=*

# development: verification / reset codes are printed to the console AND
# returned as devCode in API responses so the Flutter app can be tested
# without an email provider. NEVER enable this in production.
EXPOSE_DEV_CODES=true

# Default academic timezone for new profiles (IANA name)
DEFAULT_ACADEMIC_TIMEZONE=Asia/Yangon
